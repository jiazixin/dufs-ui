{
  "name": "dufs-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.{css,vue}\" --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/vue": "^1.77.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^31.0.1",
    "postcss-html": "^1.8.0",
    "prettier": "^3.5.2",
    "stylelint": "^16.15.0",
    "stylelint-config-standard": "^37.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
